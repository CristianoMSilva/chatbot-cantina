# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca commite o arquivo ".env" de verdade (ele já está no .gitignore).

# Banco de dados
# Para desenvolvimento local sem Postgres, pode deixar como sqlite:
DATABASE_URL=sqlite:///./dev.db

# WhatsApp Business Cloud API (Meta) — preencher quando for integrar de verdade
WHATSAPP_VERIFY_TOKEN=um-token-qualquer-que-voce-escolhe
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Nome da cantina/escola, usado nas mensagens do bot
CANTINA_NOME=Cantina Tia Eleusa
ESCOLA_NOME=Colégio Athena

# Login do painel da tia
# SECRET_KEY: gere uma chave aleatória com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USUARIO=tia
# ADMIN_SENHA_HASH: gere o hash da senha com:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
ADMIN_SENHA_HASH=
# Em produção (HTTPS), coloque true
SESSAO_COOKIE_SEGURA=false
