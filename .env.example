# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca commite o arquivo ".env" de verdade (ele já está no .gitignore).

# Banco de dados
# Para desenvolvimento local sem Postgres, pode deixar como sqlite:
DATABASE_URL=sqlite:///./dev.db

# WhatsApp Business Cloud API (Meta) — preencher quando for integrar de verdade
WHATSAPP_VERIFY_TOKEN=um-token-qualquer-que-voce-escolhe
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Nome da cantina/escola, usado nas mensagens do bot
CANTINA_NOME=Cantina Tia Eleusa
ESCOLA_NOME=Colégio Athena
